API_BASE_URL=http://localhost:8000

# Texto que dispara al bot dentro de grupos (case-insensitive).
# En DMs siempre responde, sin importar este valor.
GROUP_TRIGGER=bot

# Path al sqlite de sesión de neonize (relativo a bot_wa/).
WA_SESSION_DB=session/store.db

# LLM fallback — compatible con OpenAI / Anthropic / Groq / LM Studio.
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
